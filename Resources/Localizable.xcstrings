    "permission.alert.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon needs this permission to read battery levels from connected Razer devices. It does not record keystrokes or mouse movement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon 需要此权限来读取已连接雷蛇设备的电量。它不会记录键盘输入或鼠标移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon 需要此權限才能讀取已連接 Razer 裝置的電量。它不會記錄鍵盤輸入或滑鼠移動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されている Razer デバイスのバッテリー残量を読み取るには、この許可が必要です。キー入力やマウスの動きは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 Razer 기기의 배터리 잔량을 읽으려면 이 권한이 필요합니다. 키 입력이나 마우스 움직임은 기록하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon benötigt diese Berechtigung, um den Batteriestand verbundener Razer-Geräte auszulesen. Tastatureingaben oder Mausbewegungen werden nicht aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon a besoin de cette autorisation pour lire le niveau de batterie des appareils Razer connectés. L’app n’enregistre ni les frappes au clavier ni les mouvements de la souris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon necesita este permiso para leer el nivel de batería de los dispositivos Razer conectados. No registra las pulsaciones del teclado ni los movimientos del ratón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RazerMon precisa desta permissão para ler o nível da bateria dos dispositivos Razer conectados. Ele não registra teclas pressionadas nem movimentos do mouse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon richiede questa autorizzazione per leggere il livello della batteria dei dispositivi Razer connessi. Non registra le sequenze di tasti né i movimenti del mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon требуется это разрешение для чтения уровня заряда подключённых устройств Razer. Приложение не записывает нажатия клавиш или движения мыши."
          }
        }
      }
    },
