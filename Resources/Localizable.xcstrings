    "launch_at_login.error.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move RazerMon.app to the Applications folder, then try again.\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 RazerMon.app 移至“应用程序”文件夹，然后重试。\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將 RazerMon.app 移至「應用程式」檔案夾，然後再試一次。\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon.app を「アプリケーション」フォルダに移動してから、もう一度お試しください。\\n\\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RazerMon.app을 응용 프로그램 폴더로 이동한 후 다시 시도하십시오.\\n\\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege RazerMon.app in den Ordner „Programme“ und versuche es erneut.\\n\\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez RazerMon.app dans le dossier Applications, puis réessayez.\\n\\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve RazerMon.app a la carpeta Aplicaciones e inténtalo de nuevo.\\n\\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o RazerMon.app para a pasta Aplicativos e tente novamente.\\n\\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta RazerMon.app nella cartella Applicazioni, quindi riprova.\\n\\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите RazerMon.app в папку «Программы» и повторите попытку.\\n\\n%@"
          }
        }
      }
    },
