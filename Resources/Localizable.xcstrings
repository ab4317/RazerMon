    "error.protocol.invalid_length": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected a 90-byte report, got %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应收到 90 字节的报告，实际收到 %lld 字节"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應收到 90 位元組的報告，實際收到 %lld 位元組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90 バイトのレポートが必要ですが、%lld バイトでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90바이트 리포트가 필요하지만 %lld바이트를 받음"
          }
        },
        "de": {
          "stringUnit": {
